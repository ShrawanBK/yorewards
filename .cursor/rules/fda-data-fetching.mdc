# Data Fetching: React Query

## Where queries live

All React Query logic lives in `features/[name]/api/[name]Queries.ts`.
Never call `useQuery` or `useMutation` directly inside components.

## Query key convention

```ts
// Consistent, predictable, easy to invalidate
['feature', 'resource']           // list
['feature', 'resource', id]       // single item
['feature', 'resource', filters]  // filtered list
```

## Query hook pattern

```ts
// features/[name]/api/[name]Queries.ts
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query'
import { apiClient } from '@/shared/lib/axios'
import type { [Type] } from '../types'

// READ
export const use[Resource] = (id: string) =>
  useQuery({
    queryKey: ['[feature]', '[resource]', id],
    queryFn: () => apiClient.get<[Type]>(`/[resource]/${id}`),
    staleTime: 1000 * 60 * 5, // 5 minutes
  })

// LIST
export const use[Resource]List = (filters?: [Filters]) =>
  useQuery({
    queryKey: ['[feature]', '[resource]s', filters],
    queryFn: () => apiClient.get<[Type][]>('/[resource]s', { params: filters }),
  })

// MUTATION (create/update/delete)
export const useCreate[Resource] = () => {
  const queryClient = useQueryClient()
  return useMutation({
    mutationFn: (data: Create[Type]) =>
      apiClient.post<[Type]>('/[resource]s', data),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['[feature]', '[resource]s'] })
    },
  })
}
```

## Rules

- `staleTime` should always be set explicitly — default 0 causes excessive refetching
- Mutations must invalidate related queries `onSuccess`
- Use `select` to transform/filter data without extra state:

```ts
export const useActiveUsers = () =>
  useQuery({
    queryKey: ['users', 'list'],
    queryFn: fetchUsers,
    select: (data) => data.filter((u) => u.active),
  })
```

- Handle loading/error states in the hook, not the component when possible
- For optimistic updates, use `onMutate` + `onError` rollback pattern
