# YORewards — environment variables
# Copy the relevant app template to apps/<app>/.env.local — never commit real values.
#
# Per-app templates (required vars only):
#   apps/customer/.env.example  — Supabase + SMS (production)
#   apps/merchant/.env.example  — Supabase + NEXT_PUBLIC_APP_URL
#   apps/admin/.env.example     — Supabase + ADMIN_EMAIL
#
# Auth cookie name is set per app in next.config.ts (NEXT_PUBLIC_YOREWARDS_APP).
# Override only if needed: NEXT_PUBLIC_SUPABASE_AUTH_COOKIE_NAME=sb-yorewards-customer-auth-token

# =============================================================================
# Supabase CLI (optional — for `pnpm exec supabase gen types`)
# =============================================================================
# SUPABASE_PROJECT_ID=your-project-ref
