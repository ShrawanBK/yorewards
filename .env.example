# YORewards — environment variables (copy to apps/*/.env.local — never commit real values)

# =============================================================================
# Shared — all apps
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Per-app auth cookie (set automatically via next.config env in each app).
# Override only if needed: NEXT_PUBLIC_SUPABASE_AUTH_COOKIE_NAME=sb-yorewards-customer-auth-token

# =============================================================================
# Customer PWA — apps/customer · localhost:3000 · app.yorewards.com.np
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MERCHANT_URL=http://localhost:3001

# Reward redemption SMS — leave empty for local dev (see below)
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=YORewards
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Local dev — reward OTP without real SMS:
# 1. Run customer with `pnpm exec turbo dev --filter=customer` (NODE_ENV=development).
# 2. Leave SPARROW_SMS_TOKEN / TWILIO_* empty in apps/customer/.env.local.
# 3. Claim a reward → Send verification code → read the 6-digit OTP in the
#    terminal running the customer app, e.g. `[dev:redemption-otp] +97798...: 123456`.
# Production requires real SMS credentials; dev console fallback is disabled outside development.

# =============================================================================
# Merchant Dashboard — apps/merchant · localhost:3001 · merchant.yorewards.com.np
# =============================================================================
# NEXT_PUBLIC_MERCHANT_URL=http://localhost:3001
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Super Admin — apps/admin · localhost:3002 · admin.yorewards.com.np
# =============================================================================
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
ADMIN_EMAIL=admin@yorewards.com.np

# =============================================================================
# Supabase CLI (optional — for `pnpm exec supabase gen types`)
# =============================================================================
# SUPABASE_PROJECT_ID=your-project-ref
