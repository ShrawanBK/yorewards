# YORewards — environment variables (copy to apps/*/.env.local — never commit real values)

# =============================================================================
# Shared — all apps
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# Customer PWA — apps/customer · localhost:3000 · app.yorewards.com
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MERCHANT_URL=http://localhost:3001

# Day 5 — reward redemption SMS (placeholders until then)
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=YORewards
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_BCRYPT_ROUNDS=10

# =============================================================================
# Merchant Dashboard — apps/merchant · localhost:3001 · merchant.yorewards.com
# =============================================================================
# NEXT_PUBLIC_MERCHANT_URL=http://localhost:3001
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Super Admin — apps/admin · localhost:3002 · admin.yorewards.com
# =============================================================================
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
ADMIN_EMAIL=admin@yorewards.com

# =============================================================================
# Supabase CLI (optional — for `pnpm exec supabase gen types`)
# =============================================================================
# SUPABASE_PROJECT_ID=your-project-ref
