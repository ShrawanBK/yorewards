# Customer PWA — copy to .env.local (never commit real values)
# localhost:3000 · production: app.yorewards.com.np

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Production only (Vercel) — reward redemption SMS ---
# Local dev: omit these. With `turbo dev`, OTP is logged to the customer terminal:
#   [dev:redemption-otp] +97798...: 123456
# SPARROW_SMS_TOKEN=
# SPARROW_SMS_FROM=YORewards
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
