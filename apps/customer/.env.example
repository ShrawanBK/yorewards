# Customer PWA — copy to .env.local (never commit real values)
# localhost:3000 · production: app.yorewards.com.np

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- SMS OTP (signup + reward redemption) ---
# Routing: NP → Sparrow (falls back to Twilio if Sparrow unset) · FI → Twilio
# Local dev: leave empty — OTP is logged to the customer terminal:
#   [dev:signup-otp] +97798...: Your YORewards signup code: 123456. Valid 5 minutes.
#   [dev:redemption-otp] +97798...: Your YORewards code: 123456. Valid 5 minutes.

# Nepal (Sparrow)
# SPARROW_SMS_TOKEN=
# SPARROW_SMS_FROM=YORewards

# Finland (and optional NP fallback) — Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
