{
  "name": "yorewards",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "pnpm i18n:check && turbo run check-types",
    "i18n:check": "node scripts/i18n-check.mjs",
    "supabase:types": "supabase gen types typescript --linked 2>/dev/null > packages/supabase/src/types.generated.ts"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "supabase": "^2.105.0",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
